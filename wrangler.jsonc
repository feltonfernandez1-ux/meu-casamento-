{
  "name": "meu-casamento",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "casamento-db",
      "database_id": "COLE_AQUI_O_ID_DA_BASE_DE_DADOS"
    }
  ],
  "observability": { "enabled": true }
}
